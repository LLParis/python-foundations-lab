{
  "manifest_version": 3,
  "name": "Learning Arena Tutor Bridge",
  "version": "1.0.0",
  "description": "Sends the review request to your existing ChatGPT tutor after you press Ready in VS Code.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Learning Arena Tutor Bridge"
  },
  "key": ""
}

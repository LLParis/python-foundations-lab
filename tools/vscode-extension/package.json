{
  "name": "learning-arena",
  "displayName": "Learning Arena",
  "version": "0.3.1",
  "publisher": "llparis-local",
  "description": "Local practice tools connecting learner-written Python with an existing GPT web tutor. No model calls.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "workspaceContains:arena.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "learningArena.open",
        "title": "Open current exercise",
        "category": "Learning Arena",
        "icon": "$(book)"
      },
      {
        "command": "learningArena.notes",
        "title": "Prediction and reasoning notes",
        "category": "Learning Arena",
        "icon": "$(note)"
      },
      {
        "command": "learningArena.copy",
        "title": "Copy attempt for tutor",
        "category": "Learning Arena",
        "icon": "$(copy)"
      },
      {
        "command": "learningArena.tutor",
        "title": "Open GPT web tutor",
        "category": "Learning Arena",
        "icon": "$(link-external)"
      },
      {
        "command": "learningArena.run",
        "title": "Run when ready",
        "category": "Learning Arena",
        "icon": "$(play)"
      },
      {
        "command": "learningArena.debug",
        "title": "Debug current attempt",
        "category": "Learning Arena",
        "icon": "$(debug-alt)"
      },
      {
        "command": "learningArena.feedback",
        "title": "Save tutor feedback from clipboard",
        "category": "Learning Arena",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "learningArena.checkpoint",
        "title": "Save local checkpoint",
        "category": "Learning Arena",
        "icon": "$(git-commit)"
      },
      {
        "command": "learningArena.new",
        "title": "New exercise from clipboard",
        "category": "Learning Arena",
        "icon": "$(new-file)"
      },
      {
        "command": "learningArena.select",
        "title": "Revisit an exercise",
        "category": "Learning Arena",
        "icon": "$(history)"
      },
      {
        "command": "learningArena.progress",
        "title": "Progress and next steps",
        "category": "Learning Arena",
        "icon": "$(checklist)"
      },
      {
        "command": "learningArena.github",
        "title": "GitHub setup",
        "category": "Learning Arena",
        "icon": "$(github)"
      },
      {
        "command": "learningArena.handoff",
        "title": "Copy one-time tutor handoff",
        "category": "Learning Arena",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "learningArena.externalStatus",
        "title": "External practice dashboard",
        "category": "Learning Arena",
        "icon": "$(globe)"
      },
      {
        "command": "learningArena.externalBrowse",
        "title": "Profiles and future practice sets",
        "category": "Learning Arena",
        "icon": "$(link-external)"
      },
      {
        "command": "learningArena.externalStart",
        "title": "Start a platform exercise",
        "category": "Learning Arena",
        "icon": "$(new-file)"
      },
      {
        "command": "learningArena.externalCopy",
        "title": "Copy my code for submission",
        "category": "Learning Arena",
        "icon": "$(copy)"
      },
      {
        "command": "learningArena.externalRecord",
        "title": "Record result and attempt evidence",
        "category": "Learning Arena",
        "icon": "$(checklist)"
      },
      {
        "command": "learningArena.externalLeetCode",
        "title": "Refresh LeetCode statistics",
        "category": "Learning Arena",
        "icon": "$(sync)"
      },
      {
        "command": "learningArena.externalCodeforces",
        "title": "Refresh Codeforces statistics",
        "category": "Learning Arena",
        "icon": "$(sync)"
      },
      {
        "command": "learningArena.externalConfigure",
        "title": "Configure public profiles",
        "category": "Learning Arena",
        "icon": "$(account)"
      },
      {
        "command": "learningArena.resume",
        "title": "Resume learning",
        "category": "Learning Arena",
        "icon": "$(play-circle)"
      },
      {
        "command": "learningArena.ready",
        "title": "Ready for review",
        "category": "Learning Arena",
        "icon": "$(send)"
      },
      {
        "command": "learningArena.finish",
        "title": "Finish session",
        "category": "Learning Arena",
        "icon": "$(save)"
      },
      {
        "command": "learningArena.assistance",
        "title": "Set help used for this exercise",
        "category": "Learning Arena",
        "icon": "$(account)"
      },
      {
        "command": "learningArena.nextLesson",
        "title": "Open the waiting next exercise",
        "category": "Learning Arena",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "learningArena",
          "title": "Learning Arena",
          "icon": "media/arena.svg"
        }
      ]
    },
    "views": {
      "learningArena": [
        {
          "id": "learningArena.today",
          "name": "Your practice workspace",
          "when": "learningArena.active"
        },
        {
          "id": "learningArena.external",
          "name": "External practice",
          "when": "learningArena.active",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "learningArena.ready",
          "when": "learningArena.active && resourceFilename == attempt.py",
          "group": "navigation@1"
        },
        {
          "command": "learningArena.run",
          "when": "learningArena.active && resourceFilename == attempt.py",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "learningArena.copy",
        "key": "ctrl+alt+c",
        "when": "learningArena.active"
      },
      {
        "command": "learningArena.run",
        "key": "ctrl+alt+r",
        "when": "learningArena.active"
      },
      {
        "command": "learningArena.new",
        "key": "ctrl+alt+n",
        "when": "learningArena.active"
      },
      {
        "command": "learningArena.ready",
        "key": "ctrl+alt+enter",
        "when": "learningArena.active"
      }
    ],
    "configuration": {
      "title": "Learning Arena",
      "properties": {
        "learningArena.dailyMode": {
          "type": "boolean",
          "default": true,
          "description": "Resume the current lesson and receive tutor exercises through the connected GitHub repository. Makes no model calls."
        }
      }
    }
  }
}
